{
  "expo": {
    "name": "VKU Room Booking",
    "slug": "vku-room-booking",
    "version": "1.0.0",
    "description": "Ứng dụng đặt phòng học và phòng lab trong khuôn viên VKU.",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/app-icon.png",
